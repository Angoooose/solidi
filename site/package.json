{
  "name": "solidi-site",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:local": "wrangler d1 execute solidi --local --yes --file=../build/trajan/solidi.sql",
    "db:local:full": "for f in ../build/solidi-*.sql; do wrangler d1 execute solidi --local --yes --file=$f || exit 1; done",
    "basemaps": "node scripts/basemaps.mjs",
    "summaries": "node --experimental-sqlite --import tsx scripts/summaries.ts",
    "facets": "node --experimental-sqlite --import tsx scripts/facets.ts",
    "facets:remote": "npm run facets -- --remote ../build/solidi.sqlite"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.164.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/topojson-client": "^3.1.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2"
  }
}
