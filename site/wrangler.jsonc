{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-16",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "solidi",
	"routes": [
		{
			"pattern": "solidi.org",
			"custom_domain": true
		}
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// The built dataset (pipeline: `uv run solidi export-d1`). database_id is a placeholder until
	// the remote database is created with `wrangler d1 create solidi`; local dev doesn't need it.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "solidi",
			"database_id": "a029c8a3-cf3f-4ea1-925a-d3c1dbb38d90"
		},
		{
			"binding": "solidi",
			"database_name": "solidi",
			"database_id": "a029c8a3-cf3f-4ea1-925a-d3c1dbb38d90"
		}
	],
	// The facet index for each database build (src/lib/facet/store.ts), uploaded by `npm run facets:remote`.
	"kv_namespaces": [
		{
			"binding": "FACETS",
			"id": "dacf3a0528d84feaa6e7d997180c5734"
		}
	],
	// The deploy's version id: part of the edge-cache key (src/middleware.ts), so a deploy retires
	// cached pages that point at the previous deploy's CSS and JS.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true
	}
}