---
/*
 * Site footer. Server-rendered, no script.
 * Wide screens: the wordmark and totals, then a column per collection group, Browse and Solidi in
 * one row. Phones: the wordmark on top, then the columns two abreast (the last group shares its
 * column with Browse) and Solidi across both. lg:contents lets the phone wrappers drop away so
 * their children sit in the wide grid.
 */
import { env } from "cloudflare:workers"
import { Wordmark } from "@/components/site-chrome"
import { fmt } from "@/lib/categories"
import { CONTACT_EMAIL, GITHUB_URL, NOMISMA, getFooterData } from "@/lib/footer"

const data = await getFooterData(env.DB)
const groups = data.groups
const lastGroup = groups.at(-1)

const BROWSE = [
  ["Collections", "/collections"],
  ["People", "/people"],
  ["Mints", "/mints"],
  ["Denominations", "/denominations"],
  ["Subjects", "/subjects"],
] as const
const SOLIDI = [
  ["About", "/about"],
  ["Sources", "/sources"],
  ["Source code", GITHUB_URL],
] as const

/* The ODbL is named in full in the credit line; other licences by their short names. */
const licenceName = (label: string) => (label === "ODbL" ? "the Open Database Licence" : label)
/* "A, B and C": the separator to put before item i of n. */
const sep = (i: number, n: number) => (i === 0 ? "" : i === n - 1 ? " and " : ", ")

const updated = data.builtAt
  ? new Date(data.builtAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : null
const year = (data.builtAt ? new Date(data.builtAt) : new Date()).getUTCFullYear()

const link = "text-ui text-ink underline-offset-4 hover:underline"
const heading = "m-0 mb-3.5 text-label font-normal text-stone"
---
<footer class="border-t border-hairline bg-shelf text-ink">
  <div class="mx-auto grid max-w-page gap-12 px-[clamp(16px,4vw,56px)] pt-12 pb-9 lg:grid-cols-[1.3fr_1fr_1fr_0.8fr_0.8fr] lg:pt-[72px] lg:pb-14">
    <div class="flex flex-col gap-[18px] lg:gap-[22px]">
      <Wordmark className="self-start lg:text-[28px]" />
      <p class="m-0 max-w-[26ch] font-serif text-[1.25rem] leading-[1.25] lg:text-[1.375rem]">
        An open encyclopedia of Greek and Roman coinage.
      </p>
      <span class="text-label text-stone tabular-nums">
        {fmt(data.types)} types · {fmt(data.specimens)} specimens · {fmt(data.collections)} collections
      </span>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-9 border-t border-hairline pt-8 lg:contents">
      {groups.slice(0, -1).map((g) => (
        <nav aria-label={`${g.name} collections`}>
          <h2 class={heading}>{g.name}</h2>
          <ul class="m-0 flex list-none flex-col gap-[9px] p-0">
            {g.collections.map((c) => <li><a href={`/category/${c.id}`} class={link}>{c.name}</a></li>)}
          </ul>
        </nav>
      ))}
      <div class="flex flex-col gap-9 lg:contents">
        {lastGroup && (
          <nav aria-label={`${lastGroup.name} collections`}>
            <h2 class={heading}>{lastGroup.name}</h2>
            <ul class="m-0 flex list-none flex-col gap-[9px] p-0">
              {lastGroup.collections.map((c) => <li><a href={`/category/${c.id}`} class={link}>{c.name}</a></li>)}            </ul>
          </nav>
        )}
        <nav aria-label="Browse">
          <h2 class={heading}>Browse</h2>
          <ul class="m-0 flex list-none flex-col gap-[9px] p-0">
            {BROWSE.map(([label, href]) => <li><a href={href} class={link}>{label}</a></li>)}
          </ul>
        </nav>
      </div>
      <nav aria-label="Solidi" class="col-span-2 lg:col-span-1">
        <h2 class={heading}>Solidi</h2>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-[9px] p-0 lg:flex lg:flex-col">
          {SOLIDI.map(([label, href]) => <li><a href={href} class={link}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <div class="mx-auto max-w-page px-[clamp(16px,4vw,56px)]">
    <div class="prose flex flex-col gap-3.5 border-t border-hairline py-7 text-label leading-[1.6] text-graphite lg:grid lg:grid-cols-[1.4fr_1.2fr_1fr] lg:gap-12 lg:py-8">
      <p class="m-0">
        Type data{data.licences.map((g, i) => (
          <>
            {i === 0 ? " from " : ", from "}
            {g.sources.map((s, j) => (
              <>{sep(j, g.sources.length)}{s.url ? <a href={s.url}>{s.label}</a> : s.label}</>
            ))}
            {" under "}{licenceName(g.licence)}
          </>
        ))}, and concepts from <a href={NOMISMA.url}>{NOMISMA.label}</a> under {NOMISMA.licence}.
        Solidi’s database is shared under the ODbL.
      </p>
      <p class="m-0">
        The coins belong to the {fmt(data.holders)} museums and collections that hold them. Photographs
        are shown under each holder’s terms and credited beside every image. To correct a record or ask
        for an image to be removed, write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
      <p class="m-0">
        Solidi is independent and non-commercial. It does not authenticate, value or sell coins, and is
        not affiliated with the projects or institutions it draws on.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-page px-[clamp(16px,4vw,56px)]">
    <div class="flex flex-col-reverse gap-3 border-t border-hairline pt-[18px] pb-7 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between lg:gap-x-8 lg:pt-5 lg:pb-8">
      <span class="text-label text-stone tabular-nums">
        © {year} Solidi{updated && ` · Data updated ${updated}`}
      </span>
      <span class="flex flex-wrap items-center gap-x-5 gap-y-2 text-label lg:gap-x-6">
        <a href="/privacy" class="text-stone transition-colors hover:text-ink">Privacy</a>
        <a href="/terms" class="text-stone transition-colors hover:text-ink">Terms of use</a>
        <a href="/sources" class="text-stone transition-colors hover:text-ink">Licences and credits</a>
        <span aria-hidden="true" class="hidden h-4 w-px bg-field lg:block"></span>
        <a href={GITHUB_URL} aria-label="Solidi on GitHub" class="inline-flex text-stone transition-colors hover:text-ink">
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </span>
    </div>
  </div>
</footer>
