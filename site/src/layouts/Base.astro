---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { canonicalView } from "@/lib/seo";
interface Props {
  /** The page's name; " · Solidi" is added unless it already starts with Solidi (Home). */
  title: string
  /** The page shows Kharoshthi, Phoenician, Brahmi, Lycian or Carian text: load Noto fonts for those scripts. */
  scripts?: boolean
  /** What a search result or shared link says about the page; the site's own line when not given. */
  description?: string
}
const DESCRIPTION =
  "An encyclopedia of ancient coins: over 100,000 types of coin from the Greek world and Rome, with photographs from museum collections."
const { title, scripts = false, description = DESCRIPTION } = Astro.props;
const fullTitle = title.startsWith("Solidi") ? title : `${title} · Solidi`
/*
 * The canonical URL, and whether search engines may index this view (lib/seo.ts): a page without
 * a query string, or an index page scoped to one collection. Filtered, sorted and "show more"
 * views are noindex, follow, and name the page itself as canonical.
 */
const site = Astro.site ?? new URL(Astro.url.origin)
const { canonical: path, indexable } = canonicalView(Astro.url)
const url = new URL(path, site).href
/* Link previews (Open Graph, X): one image for every page, public/og.jpg, the Met's aureus of Julia Domna (CC0) beside the wordmark. */
const image = new URL("/og.jpg", site).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solidi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solidi, an encyclopedia of ancient coins, beside a gold aureus of Julia Domna" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {scripts && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+Brahmi&family=Noto+Sans+Carian&family=Noto+Sans+Kharoshthi&family=Noto+Sans+Lycian&family=Noto+Sans+Phoenician&display=swap"
        />
      </>
    )}
    <!-- Same-site links swap the page in place instead of a full reload (~5 KB). -->
    <ClientRouter />
    <!--
      Coin photo states (components/coin.tsx, global.css). Inline in the head so its listeners
      exist before any photo can load or fail. A photo is marked loaded or failed; its plinth is
      loaded when all have loaded, failed when all have failed, partial when some failed and the
      rest loaded. Retry reloads failed photos.
    -->
    <script is:inline>
      (() => {
        if (window.__coinPhotos) return
        window.__coinPhotos = true
        const mark = () => document.documentElement.setAttribute("data-js", "")
        mark()
        document.addEventListener("astro:after-swap", mark)
        const settle = (plinth) => {
          const photos = [...plinth.querySelectorAll("img[data-coin-photo]")].map((i) => i.dataset.photo)
          const settled = photos.every((p) => p === "loaded" || p === "failed")
          plinth.dataset.photo = !settled
            ? ""
            : photos.every((p) => p === "failed")
              ? "failed"
              : photos.includes("failed")
                ? "partial"
                : "loaded"
        }
        for (const type of ["load", "error"]) {
          document.addEventListener(
            type,
            (e) => {
              const img = e.target
              if (!(img instanceof HTMLImageElement) || !img.hasAttribute("data-coin-photo")) return
              img.dataset.photo = type === "load" ? "loaded" : "failed"
              const plinth = img.closest("[data-plinth]")
              if (plinth) settle(plinth)
            },
            true
          )
        }
        document.addEventListener("click", (e) => {
          const button = e.target.closest?.("[data-coin-retry]")
          const plinth = button?.closest("[data-plinth]")
          if (!plinth) return
          e.preventDefault()
          for (const img of plinth.querySelectorAll('img[data-coin-photo][data-photo="failed"]')) {
            img.dataset.photo = ""
            const src = img.src
            img.removeAttribute("src")
            img.src = src
          }
          settle(plinth)
        })
      })()
    </script>
  </head>
  <body>
    <slot />
    <script>
      /*
       * Links and filters marked data-keep-scroll (coinage tabs, filters, "Show more") update part
       * of the page, so the new page keeps the reader's scroll position instead of jumping.
       */
      import { navigate } from "astro:transitions/client"

      let keep: number | null = null
      document.addEventListener("click", (e) => {
        const link = (e.target as Element).closest?.("a[data-keep-scroll]")
        if (link) keep = window.scrollY
      })
      document.addEventListener("solidi:navigate-keep-scroll", ((e: CustomEvent<string>) => {
        keep = window.scrollY
        navigate(e.detail)
      }) as EventListener)
      document.addEventListener("astro:after-swap", () => {
        if (keep != null) window.scrollTo({ top: keep, behavior: "instant" })
        keep = null
      })
    </script>
  </body>
</html>
