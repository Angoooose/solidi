---
/*
 * Home: what Solidi is and a search box (it opens the ⌘K palette), four doors
 * into the indexes (people, mints, denominations, subjects), the collection tree, and the
 * museums whose photographs we show. lib/home.ts reads it all from the summary tables.
 */
import { env } from "cloudflare:workers"
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { ArrowLink, CollectionHalf, Door, IndexLine } from "@/components/home"
import { fmt } from "@/lib/categories"
import { getHome } from "@/lib/home"

const home = await getHome(env.DB)

const NUMBERS = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen"]
const centuries = home.start != null && home.end != null ? Math.round((home.end - home.start) / 100) : 0
const span = NUMBERS[centuries] ? ` over ${NUMBERS[centuries]} centuries` : ""
---

<Base title="Solidi · An encyclopedia of ancient coins">
  <SiteHeader />
  <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)]">
    {/* What it is, and search */}
    <section class="flex flex-col items-center gap-9 pt-16 pb-20 text-center md:pt-24 md:pb-22">
      <div class="flex flex-col items-center gap-6">
        <h1 class="m-0 font-serif text-[clamp(2.75rem,5vw,4.5rem)] leading-[1.02] font-normal tracking-[-0.02em] text-balance">An encyclopedia of ancient coins</h1>
        <p class="num m-0 text-[1.125rem] leading-normal text-graphite">{fmt(home.types)} types of coin from the Greek world and Rome, struck{span}.</p>
      </div>
      <button
        type="button"
        data-open-search
        class="flex h-16 w-full max-w-[760px] cursor-text items-center gap-3.5 border border-field bg-white pr-3.5 pl-5.5 text-left transition-colors hover:border-ink focus-visible:border-ink focus-visible:outline-none"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="flex-none text-ink"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="min-w-0 flex-1 truncate text-[1.125rem] text-stone">Search by catalogue reference, ruler or mint</span>
        <kbd data-shortcut class="hidden border border-hairline px-1.5 py-px font-sans text-label text-stone sm:inline">⌘K</kbd>
      </button>
    </section>

    {/* Four doors into the indexes */}
    <section class="flex flex-col gap-10 border-t border-hairline pt-18 pb-22">
      <h2 class="m-0 font-serif text-heading font-normal">Browse</h2>
      <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
        <Door
          href="/people"
          title="People"
          total={home.people.total}
          noun="people"
          text="Kings, emperors, magistrates and moneyers, with every coin issued in their name."
          picture={{ kind: "coin", photo: home.people.photo }}
          top={home.people.top}
          itemHref={(id) => `/person/${id}`}
        />
        <Door
          href="/mints"
          title="Mints"
          total={home.mints.total}
          noun="mints"
          text="Where the coins were struck, and when each was active."
          picture={{ kind: "mints", mints: home.mints.dots }}
          top={home.mints.top}
          itemHref={(id) => `/mint/${id}`}
        />
        <Door
          href="/denominations"
          title="Denominations"
          total={home.denominations.total}
          noun="denominations"
          text="Gold, silver and bronze: what each coin was worth and how it changed."
          picture={{ kind: "coins", coins: home.denominations.coins }}
          top={home.denominations.top}
          itemHref={(id) => `/denomination/${id}`}
        />
        <Door
          href="/subjects"
          title="Subjects"
          total={home.subjects.total}
          noun="subjects"
          text="The gods, personifications and places on the coins, and every type that shows them."
          picture={{ kind: "coin", photo: home.subjects.photo }}
          top={home.subjects.top}
          itemHref={(id) => `/subject/${id}`}
        />
      </div>
    </section>

    {/* The collection tree */}
    <section class="flex flex-col gap-10 border-t border-hairline pt-18 pb-22">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="m-0 font-serif text-heading font-normal">Collections</h2>
        <ArrowLink href="/collections">All collections</ArrowLink>
      </div>
      <div class="grid items-start gap-x-24 gap-y-14 md:grid-cols-2">
        {home.collections.map((half) => <CollectionHalf half={half} />)}
      </div>
    </section>

    {/* Whose photographs */}
    <section class="flex flex-wrap gap-x-20 gap-y-10 border-t border-hairline pt-18 pb-24">
      <div class="flex flex-[1_1_300px] flex-col gap-3">
        <h2 class="m-0 font-serif text-heading font-normal">Photographs from {fmt(home.holders.total)} collections</h2>
        <p class="m-0 max-w-[40ch] text-body text-graphite">With thanks to the museums and universities that photograph their coins and share them openly.</p>
      </div>
      <div class="grid min-w-0 flex-[2_1_600px] grid-flow-col grid-rows-2 gap-x-12 border-t border-ink pt-1.5 max-sm:grid-flow-row max-sm:grid-rows-none">
        {home.holders.top.map((h) => <IndexLine name={h.name} n={h.n} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  // The big search box opens the ⌘K palette (components/search-command.tsx).
  document.addEventListener("click", (e) => {
    if ((e.target as Element | null)?.closest("[data-open-search]")) document.dispatchEvent(new CustomEvent("solidi:open-search"))
  })
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll("[data-shortcut]").forEach((k) => (k.textContent = "Ctrl K"))
</script>
