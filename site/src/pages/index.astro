---
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { SiteFooter, PageTitle } from "@/components/site-chrome"
import { typePath } from "@/lib/format"

// Placeholder home page until the real one is built: a few coin types to open.
const samples = [
  ["ocre/ric.2.tr.98", "RIC II Trajan 98", "Dacia in mourning"],
  ["ocre/ric.2.tr.147", "RIC II Trajan 147", "Trophy of shields"],
  ["ocre/ric.2.tr.528", "RIC II Trajan 528", "Victory with Dacian shield"],
  ["ocre/ric.2.tr.252", "RIC II Trajan 252", "Trajan's father seated"],
]
---
<Base title="Solidi">
  <SiteHeader />
  <main class="mx-auto flex max-w-page flex-col gap-10 px-[clamp(20px,4vw,56px)] py-16">
    <PageTitle title="Solidi" subtitle="Roman Imperial coinage" />
    <ul class="m-0 flex list-none flex-col border-t border-hairline p-0">
      {samples.map(([id, ref, name]) => (
        <li class="border-b border-hairline py-3.5">
          <a href={typePath(id)} class="underline-offset-4 hover:underline">{ref}</a>
          <span class="text-stone">, {name}</span>
        </li>
      ))}
    </ul>
  </main>
  <SiteFooter />
</Base>
