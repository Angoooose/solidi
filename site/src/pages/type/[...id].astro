---
/*
 * Coin-type page: /type/ocre/ric.2.tr.98 (a rest route: type IDs are '{dataset}/{source id}'). Server-rendered from D1. Client JavaScript: the copy button
 * and the specimens table (an island, loaded when scrolled into view).
 */
import { env } from "cloudflare:workers"
import Base from "@/layouts/Base.astro"
import { SiteHeader, SiteFooter, SectionHeading } from "@/components/site-chrome"
import { DataList, DataRow, RowLink } from "@/components/data"
import { CoinPair, TypeCard } from "@/components/coin"
import { SpecimenTable } from "@/components/specimens"
import { PhotoCredit } from "@/components/credits"
import { LegendGloss, LegendText, NEEDS_SCRIPT_FONTS } from "@/components/legend"
import { buttonVariants } from "@/components/ui/button"
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb"
import { getCoinType } from "@/lib/coinType"
import { acsearchUrl, capitalise, typePath } from "@/lib/format"

/* Astro decodes the path but leaves reserved characters escaped: '%3F' for the '?' in some source IDs (lib/format.ts typePath). */
const id = (() => {
  const raw = Astro.params.id ?? ""
  try {
    return decodeURIComponent(raw)
  } catch {
    return raw
  }
})()
const result = await getCoinType(env.DB, id)

if (result.kind === "redirect") return Astro.redirect(typePath(result.to), 301)
if (result.kind === "missing") {
  Astro.response.status = 404
}
const type = result.kind === "found" ? result.type : null

/* The ruler who struck it; else, for a coin struck in a ruler's name by someone else, that ruler. */
const authority = type?.authorities.find((p) => p.role === "authority") ?? null
const stated = type?.statedAuthorities[0] ?? null
const ruler = authority ?? stated ?? type?.authorities[0] ?? null
/* "denarius", but "denomination B (double)": only the initial is lowered. */
const denomination = type?.denominations.map((d) => d.name.charAt(0).toLowerCase() + d.name.slice(1)).join(" or ")
const material = type?.materials[0]?.toLowerCase()

/*
 * "Silver denarius of Trajan, struck at Rome, AD 103–111", "Silver tetradrachm of Ptolemy I in the
 * name of Alexander III": built only from fields we have. A magistrate (role 'issuer') names the
 * coin only when no ruler is named on it.
 */
const strucker = authority ?? type?.organizations[0] ?? (stated ? null : type?.authorities[0]) ?? null
const subtitle = type
  ? capitalise(
      [
        [material, denomination].filter(Boolean).join(" ") || "Coin",
        strucker ? ` of ${strucker.name}` : "",
        stated ? ` in the name of ${stated.name}` : "",
        type.mint ? `, ${type.mint.uncertain ? "probably struck" : "struck"} at ${type.mint.name}` : "",
        type.date ? `, ${type.date}` : "",
      ].join("")
    )
  : ""

const acsearch = type?.catalogue
  ? acsearchUrl(type.catalogue.work, type.catalogue.volume, type.catalogue.number, ruler?.name ?? null)
  : null
/* Kharoshthi, Phoenician or Brahmi on the page: load the Noto fonts for them. */
const scripts = !!type?.sides.some((s) => s.legend && NEEDS_SCRIPT_FONTS.test(s.legend + (s.transliteration ?? "")))
const anyMarks = type?.sides.some((s) => s.marks.length)
const sideLabel = { obverse: "Obverse", reverse: "Reverse" } as const
const sideHint = { obverse: "Front of the coin", reverse: "Back of the coin" } as const
const sidePhoto = (side: "obverse" | "reverse") => type?.hero?.photos.find((p) => p.side === side)?.src ?? null
/* The grey-letters note only applies to Latin glosses (abbreviations written out). */
const anyGloss = type?.sides.some((s) => s.segments?.length && (s.language ?? "la") === "la")

---

<Base title={type ? `${type.reference}` : "Type not found"} scripts={scripts}>
  <SiteHeader />
  {
    !type ? (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)] py-24">
        <h1 class="m-0 font-serif text-display font-normal">Type not found</h1>
        <p class="mt-6 text-body text-stone">
          There is no coin type <span class="text-ink">{id}</span>. Check the reference, or search for it.
        </p>
      </main>
    ) : (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)]">
        {/* Photo beside the facts */}
        <section class="flex flex-wrap items-stretch gap-x-20 gap-y-12 pt-12 pb-26">
          <CoinPair photos={type.hero?.photos ?? []} size="hero" className="min-w-0 flex-[1.4_1_560px] justify-between">
            {type.hero && (
              <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1.5 text-credit text-stone">
                <span>{type.hero.photos.length === 2 ? "Obverse and reverse" : "Obverse and reverse, one photograph"}</span>
                <PhotoCredit
                  photos={[{ holder: type.hero.credit.holder, sourceUrl: type.hero.credit.url, licence: type.hero.credit.licence }]}
                />
              </figcaption>
            )}
          </CoinPair>

          <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-10">
            <Breadcrumb>
              <BreadcrumbList>
                {type.categoryPath.map((c) => (
                  <>
                    <BreadcrumbItem>
                      <BreadcrumbLink href={`/category/${c.id}`}>{c.name}</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                  </>
                ))}
                {ruler && (
                  <>
                    <BreadcrumbItem>
                      <BreadcrumbLink href={`/ruler/${ruler.id}`}>{ruler.name}</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                  </>
                )}
                <BreadcrumbItem>
                  <BreadcrumbPage>
                    {type.catalogue?.volume && type.catalogue.number
                      ? `${type.catalogue.volume} ${type.catalogue.number}`
                      : (type.catalogue?.label ?? type.reference)}
                  </BreadcrumbPage>
                </BreadcrumbItem>
              </BreadcrumbList>
            </Breadcrumb>

            <div class="flex flex-col gap-4">
              <h1 class="m-0 font-serif text-display font-normal">{type.reference}</h1>
              <p class="m-0 text-subtitle text-pretty text-graphite">{subtitle}</p>
            </div>

            <DataList>
              <DataRow label="Reference">
                {type.reference}
                <button
                  slot="action"
                  type="button"
                  data-copy={type.reference}
                  class="text-label text-stone underline-offset-4 hover:text-ink hover:underline"
                >
                  Copy
                </button>
              </DataRow>
              {type.authorities.length > 0 && (
                <DataRow label={type.authorities.length > 1 ? "Issuers" : "Issuer"}>
                  {type.authorities.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/ruler/${p.id}`}>{p.name}</RowLink>
                      {p.years && <span class="text-stone">, {p.years}</span>}
                    </>
                  ))}
                </DataRow>
              )}
              {type.statedAuthorities.length > 0 && (
                <DataRow
                  label="In the name of"
                  note={type.authorities.length || type.organizations.length ? undefined : "issuer not recorded"}
                >
                  {type.statedAuthorities.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/ruler/${p.id}`}>{p.name}</RowLink>
                      {p.years && <span class="text-stone">, {p.years}</span>}
                    </>
                  ))}
                </DataRow>
              )}
              {type.organizations.length > 0 && (
                <DataRow label="Issued by">
                  {type.organizations.map((o, i) => (
                    <>
                      {i > 0 && ", "}
                      {o.name}
                    </>
                  ))}
                </DataRow>
              )}
              {type.portraits.length > 0 && (
                <DataRow label="Portrait">
                  {type.portraits.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/ruler/${p.id}`}>{p.name}</RowLink>
                    </>
                  ))}
                </DataRow>
              )}
              {type.mint && (
                <DataRow label="Mint" href={`/mint/${type.mint.id}`} note={type.mint.uncertain ? "uncertain" : undefined}>
                  {type.mint.name}
                </DataRow>
              )}
              {type.mintUnknown && (
                <DataRow label="Mint">
                  <span class="text-stone">Uncertain</span>
                </DataRow>
              )}
              {type.date && <DataRow label="Date">{type.date}</DataRow>}
              {type.denominations.length > 0 && (
                <DataRow label="Denomination" note={material}>
                  {type.denominations.map((d, i) => (
                    <>
                      {i > 0 && " or "}
                      <RowLink href={`/denomination/${d.id}`}>{d.name}</RowLink>
                    </>
                  ))}
                </DataRow>
              )}
              {type.subjects.length > 0 && (
                <DataRow label={type.subjects.length > 1 ? "Subjects" : "Subject"}>
                  {type.subjects.map((s, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/subject/${s.id}`}>{s.name}</RowLink>
                      {s.side === "obverse" && <span class="text-stone"> (obverse)</span>}
                    </>
                  ))}
                </DataRow>
              )}
              {type.parent && (
                <DataRow label="Variant of" href={typePath(type.parent.id)}>
                  {type.parent.reference}
                </DataRow>
              )}
            </DataList>

            <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
              {acsearch && (
                <a href={acsearch} rel="noopener" class={buttonVariants({ variant: "link" })}>Past sales on ACSearch ↗</a>
              )}
              <a href={type.sourceUri} rel="noopener" class={buttonVariants({ variant: "link" })}>View on {type.source.slug.toUpperCase()} ↗</a>
            </div>
          </div>
        </section>

        {/* Legends, word by word */}
        {type.sides.length > 0 && (
          <section class="flex flex-wrap gap-x-20 gap-y-10 border-t border-hairline pt-18 pb-22">
            <h2 class="m-0 flex-[1_1_220px] font-serif text-heading font-normal">{anyMarks ? "Legends and marks" : "Legends"}</h2>
            <div class="flex min-w-0 flex-[3_1_640px] flex-col gap-16">
              {type.sides.map((s) => (
                <div class="flex flex-col gap-7">
                  <div class="flex items-center gap-5">
                    {sidePhoto(s.side) && (
                      <img src={sidePhoto(s.side)!} alt="" class="size-16 flex-none rounded-full object-cover" loading="lazy" />
                    )}
                    <div class="flex min-w-0 flex-col">
                      <span class="text-body">{sideLabel[s.side]}</span>
                      <span class="text-label text-stone">
                        {sideHint[s.side]}
                        {s.description && ` · ${s.description}`}
                      </span>
                    </div>
                  </div>
                  {s.segments?.length ? (
                    <div class="flex flex-col gap-5">
                      {/* Gandhari segments are transliterated: show the Kharoshthi original above them. */}
                      {s.language === "pgd" && s.legend && <LegendText legend={s.legend} language={s.language} />}
                      <LegendGloss segments={s.segments} language={s.language} rulers={new Set(s.rulers)} />
                      {s.transliteration && (
                        <p class="m-0 font-serif text-[18px] leading-snug text-stone italic">
                          <span class="sr-only">Transliteration: </span>
                          {s.transliteration}
                        </p>
                      )}
                    </div>
                  ) : s.legend ? (
                    <LegendText legend={s.legend} language={s.language} transliteration={s.transliteration} />
                  ) : (
                    <p class="m-0 text-body text-stone">No legend.</p>
                  )}
                  {s.marks.length > 0 && (
                    <ul class="m-0 flex list-none flex-wrap gap-x-8 gap-y-6 p-0" aria-label={`${sideLabel[s.side]} monograms and marks`}>
                      {s.marks.map((m) => (
                        <li>
                          <figure class="m-0 flex w-28 flex-col gap-2" title={m.definition ?? undefined}>
                            <span class="flex size-16 items-center justify-center bg-plinth p-2">
                              {m.image ? (
                                <img src={m.image} alt={m.letters ? `Monogram of ${m.letters}` : m.name} class="size-full object-contain mix-blend-multiply" loading="lazy" />
                              ) : (
                                <span class="text-center text-credit text-stone">No drawing</span>
                              )}
                            </span>
                            <figcaption class="flex flex-col text-credit text-stone">
                              <span class="text-ink">{m.name}</span>
                              {m.letters && (
                                <span lang={/[\u0370-\u03FF]/.test(m.letters) ? "grc" : undefined} class="font-serif text-label tracking-[0.08em]">
                                  {m.letters}
                                </span>
                              )}
                              {m.uncertain && <span>uncertain</span>}
                            </figcaption>
                          </figure>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
              {anyGloss && (
                <p class="-mt-6 text-label text-stone">Letters in grey are not on the coin; they complete the abbreviations.</p>
              )}
            </div>
          </section>
        )}

        {/* Museum coins of this type: the one interactive island on the page */}
        <section class="flex flex-col gap-8 border-t border-hairline pt-18 pb-22">
          <SectionHeading>Specimens</SectionHeading>
          {type.specimens.length ? (
            <SpecimenTable
              client:visible
              specimens={type.specimens.map((s) => ({
                id: s.id,
                url: s.url,
                holder: s.holder,
                identifier: s.identifier,
                weight: s.weight,
                diameter: s.diameter,
                dieAxis: s.dieAxis,
                licence: s.credit.licence,
                thumbs: s.thumbs,
                photos: s.photos,
              }))}
            />
          ) : (
            <p class="m-0 text-body text-stone">No museum specimens are linked to this type yet.</p>
          )}
        </section>

        {type.variants.length > 0 && (
          <section class="flex flex-col gap-10 border-t border-hairline pt-18 pb-22">
            <SectionHeading aside={`${type.variants.length}`}>Variants</SectionHeading>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-x-6 gap-y-10">
              {type.variants.map((v) => (
                <TypeCard href={typePath(v.id)} image={v.image} title={v.title} reference={v.reference} meta={v.meta} />
              ))}
            </div>
            <PhotoCredit photos={type.variantCredits} />
          </section>
        )}

        {type.related.length > 0 && (
          <section class="flex flex-col gap-10 border-t border-hairline pt-18 pb-24">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="m-0 font-serif text-heading font-normal">Related types</h2>
              {ruler &&
                (ruler === stated ? (
                  <a href={`/ruler/${ruler.id}?struck=name`} class={buttonVariants({ variant: "link" })}>All types in the name of {ruler.name}</a>
                ) : (
                  <a href={`/ruler/${ruler.id}`} class={buttonVariants({ variant: "link" })}>All types of {ruler.name}</a>
                ))}
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-x-6 gap-y-10">
              {type.related.map((r) => (
                <TypeCard href={typePath(r.id)} image={r.image} title={r.title} reference={r.reference} meta={r.meta} />
              ))}
            </div>
            <PhotoCredit photos={type.relatedCredits} />
          </section>
        )}
      </main>
    )
  }
  <SiteFooter />
</Base>

<script>
  // Runs on every page load, including client-router navigations (scripts only run once otherwise).
  document.addEventListener("astro:page-load", () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        const label = button.textContent
        button.textContent = "Copied"
        setTimeout(() => (button.textContent = label), 1500)
      })
    }
  })
</script>
