---
/*
 * Coin-type page: /type/ocre/ric.2.tr.98 (a rest route: type IDs are '{dataset}/{source id}'). Server-rendered from D1. Client JavaScript: the copy button
 * and the specimens table (an island, loaded when scrolled into view).
 */
import { env } from "cloudflare:workers"
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { SectionHeading } from "@/components/site-chrome"
import SiteFooter from "@/components/SiteFooter.astro"
import { DataList, DataRow, RowLink } from "@/components/data"
import { CoinPair, PlinthNote, TypeCard } from "@/components/coin"
import { SpecimenTable } from "@/components/specimens"
import { PhotoCredit } from "@/components/credits"
import { LegendTable, LegendText, NEEDS_SCRIPT_FONTS } from "@/components/legend"
import { buttonVariants } from "@/components/ui/button"
import { ExternalLink } from "@/components/external-link"
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb"
import { getCoinType } from "@/lib/coinType"
import { typeDescription, typeTitle } from "@/lib/meta"
import { acsearchUrl, capitalise, plinthLegend, typePath } from "@/lib/format"

/* Astro decodes the path but leaves reserved characters escaped: '%3F' for the '?' in some source IDs (lib/format.ts typePath). */
const id = (() => {
  const raw = Astro.params.id ?? ""
  try {
    return decodeURIComponent(raw)
  } catch {
    return raw
  }
})()
const result = await getCoinType(env.DB, id)

if (result.kind === "redirect") return Astro.redirect(typePath(result.to), 301)
if (result.kind === "missing") {
  Astro.response.status = 404
}
const type = result.kind === "found" ? result.type : null

/* The ruler who struck it; else, for a coin struck in a ruler's name by someone else, that ruler. */
const authority = type?.authorities.find((p) => p.role === "authority") ?? null
const stated = type?.statedAuthorities[0] ?? null
const ruler = authority ?? stated ?? type?.authorities[0] ?? null
/* "denarius", but "denomination B (double)": only the initial is lowered. */
const denomination = type?.denominations.map((d) => d.name.charAt(0).toLowerCase() + d.name.slice(1)).join(" or ")
const material = type?.materials[0]?.toLowerCase()

/* Without a photo, each side's legend is pressed into the plinth, if it's in Latin or Greek letters. */
const plinthSide = (side: "obverse" | "reverse") => {
  const s = type?.sides.find((x) => x.side === side)
  return s && (s.language == null || s.language === "la" || s.language === "grc") ? plinthLegend(s.legend) : null
}
const plinthLegends = { obverse: plinthSide("obverse"), reverse: plinthSide("reverse") }

/*
 * "Silver denarius of Trajan, struck at Rome, AD 103–111", "Silver tetradrachm of Ptolemy I in the
 * name of Alexander III": built only from fields we have. A magistrate (role 'issuer') names the
 * coin only when no ruler is named on it.
 */
const strucker = authority ?? type?.organizations[0] ?? (stated ? null : type?.authorities[0]) ?? null
const subtitle = type
  ? capitalise(
      [
        /* "Silver denarius", or "Silver coin" when the catalogue gives no denomination (Iris never does). */
        [material, denomination || "coin"].filter(Boolean).join(" "),
        /* Organisations are leagues and peoples: "of the Acarnanian League", "of the Boeotians". */
        strucker ? ` of ${strucker === type.organizations[0] && !/^the /i.test(strucker.name) ? "the " : ""}${strucker.name}` : "",
        stated ? ` in the name of ${stated.name}` : "",
        type.mint ? `, ${type.mint.uncertain ? "probably struck" : "struck"} at ${type.mint.name}` : "",
        type.date ? `, ${type.date}` : "",
      ].join("")
    )
  : ""

/* Search and link previews: "Trajan denarius, Dacian seated left · RIC II Trajan 98", and the subtitle with the reverse. */
const reverse = type?.sides.find((s) => s.side === "reverse")?.description ?? null
const pageTitle = type
  ? typeTitle({
      reference: type.reference,
      who: (strucker ?? stated)?.name ?? type.mint?.name ?? null,
      denomination: type.denominations[0] ? type.denominations[0].name.charAt(0).toLowerCase() + type.denominations[0].name.slice(1) : null,
      reverse,
    })
  : "Type not found"
const description = type ? typeDescription({ summary: subtitle, reference: type.reference, reverse }) : undefined

const acsearch = type?.catalogue
  ? acsearchUrl(type.catalogue.work, type.catalogue.volume, type.catalogue.number, ruler?.name ?? null)
  : null
/* Kharoshthi, Phoenician or Brahmi on the page: load the Noto fonts for them. */
const scripts = !!type?.sides.some((s) => s.legend && NEEDS_SCRIPT_FONTS.test(s.legend + (s.transliteration ?? "")))
const anyMarks = type?.sides.some((s) => s.marks.length)
const sideLabel = { obverse: "Obverse", reverse: "Reverse" } as const
const sidePhoto = (side: "obverse" | "reverse") => type?.hero?.photos.find((p) => p.side === side)?.src ?? null
/* Show the word-by-word gloss only when it explains something (a lone unexplained Lycian word doesn't). */
const glossed = (s: { segments: { english?: string | null }[] | null }) => !!s.segments?.some((g) => g.english)
/* Legends whose segments are transliterated words, not the script as struck. */
const TRANSLITERATED = new Set(["pgd", "xlc", "xcr"])

---

<Base title={pageTitle} description={description} scripts={scripts}>
  <SiteHeader />
  {
    !type ? (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)] py-24">
        <h1 class="m-0 font-serif text-display font-normal">Type not found</h1>
        <p class="mt-6 text-body text-stone">
          There is no coin type <span class="text-ink">{id}</span>. Check the reference, or search for it.
        </p>
      </main>
    ) : (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)]">
        {/* Photo beside the facts */}
        <section class="flex flex-wrap items-start gap-x-20 gap-y-12 pt-12 pb-26">
          <CoinPair photos={type.hero?.photos ?? []} legends={plinthLegends} size="hero" className="min-w-0 flex-[1.4_1_560px]">
            {type.hero && (
              <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1.5 text-credit text-stone">
                {/* A failed photo swaps this label for the note, beside the credit that links to the photo at its source. */}
                <span class="plinth-caption">{type.hero.photos.length === 2 ? "Obverse and reverse" : "Obverse and reverse, one photograph"}</span>
                <PlinthNote failed retry />
                <PhotoCredit
                  photos={[{ holder: type.hero.credit.holder, sourceUrl: type.hero.credit.url, licence: type.hero.credit.licence }]}
                />
              </figcaption>
            )}
          </CoinPair>

          <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-10">
            <Breadcrumb>
              <BreadcrumbList>
                {type.categoryPath.map((c) => (
                  <>
                    <BreadcrumbItem>
                      <BreadcrumbLink href={`/category/${c.id}`}>{c.name}</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                  </>
                ))}
                {ruler && (
                  <>
                    <BreadcrumbItem>
                      <BreadcrumbLink href={`/person/${ruler.id}`}>{ruler.name}</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                  </>
                )}
                <BreadcrumbItem>
                  <BreadcrumbPage>
                    {type.catalogue?.volume && type.catalogue.number
                      ? `${type.catalogue.volume} ${type.catalogue.number}`
                      : (type.catalogue?.label ?? type.reference)}
                  </BreadcrumbPage>
                </BreadcrumbItem>
              </BreadcrumbList>
            </Breadcrumb>

            <div class="flex flex-col gap-4">
              <h1 class="m-0 font-serif text-display font-normal">{type.reference}</h1>
              <p class="m-0 text-subtitle text-pretty text-graphite">{subtitle}</p>
            </div>

            <DataList>
              <DataRow label="Reference">
                {type.reference}
                <button
                  slot="action"
                  type="button"
                  data-copy={type.reference}
                  class="text-ui text-stone underline-offset-4 hover:text-ink hover:underline"
                >
                  Copy
                </button>
              </DataRow>
              {type.authorities.length > 0 && (
                <DataRow label={type.authorities.length > 1 ? "Issuers" : "Issuer"}>
                  {type.authorities.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/person/${p.id}`}>{p.name}</RowLink>
                      {p.years && <span class="text-stone">, {p.years}</span>}
                    </>
                  ))}
                </DataRow>
              )}
              {type.statedAuthorities.length > 0 && (
                <DataRow
                  label="In the name of"
                  note={type.authorities.length || type.organizations.length ? undefined : "issuer not recorded"}
                >
                  {type.statedAuthorities.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/person/${p.id}`}>{p.name}</RowLink>
                      {p.years && <span class="text-stone">, {p.years}</span>}
                    </>
                  ))}
                </DataRow>
              )}
              {type.organizations.length > 0 && (
                <DataRow label={type.authorities.length ? "Issued by" : "Issuer"}>
                  {type.organizations.map((o, i) => (
                    <>
                      {i > 0 && ", "}
                      {o.name}
                    </>
                  ))}
                </DataRow>
              )}
              {type.portraits.length > 0 && (
                <DataRow label="Portrait">
                  {type.portraits.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/person/${p.id}`}>{p.name}</RowLink>
                    </>
                  ))}
                </DataRow>
              )}
              {type.mint && (
                <DataRow label="Mint" href={`/mint/${type.mint.id}`} note={type.mint.uncertain ? "uncertain" : undefined}>
                  {type.mint.name}
                </DataRow>
              )}
              {type.mintUnknown && (
                <DataRow label="Mint">
                  <span class="text-stone">Uncertain</span>
                </DataRow>
              )}
              {type.date && <DataRow label="Date">{type.date}</DataRow>}
              {type.denominations.length > 0 && (
                <DataRow label="Denomination" note={material}>
                  {type.denominations.map((d, i) => (
                    <>
                      {i > 0 && " or "}
                      <RowLink href={`/denomination/${d.id}`}>{d.name}</RowLink>
                    </>
                  ))}
                </DataRow>
              )}
              {type.subjects.length > 0 && (
                <DataRow label={type.subjects.length > 1 ? "Subjects" : "Subject"}>
                  {type.subjects.map((s, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/subject/${s.id}`}>{s.name}</RowLink>
                      {s.side === "obverse" && <span class="text-stone"> (obverse)</span>}
                    </>
                  ))}
                </DataRow>
              )}
              {type.parent && (
                <DataRow label="Variant of" href={typePath(type.parent.id)}>
                  {type.parent.reference}
                </DataRow>
              )}
            </DataList>

            <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
              {acsearch && (
                <ExternalLink href={acsearch} className={buttonVariants({ variant: "link" })}>Past sales on ACSearch ↗</ExternalLink>
              )}
              <ExternalLink href={type.sourceUri} className={buttonVariants({ variant: "link" })}>View on {type.source.slug.toUpperCase()} ↗</ExternalLink>
            </div>
          </div>
        </section>

        {/* Legends: a row per side, its description beside the words like a catalogue entry */}
        {type.sides.length > 0 && (
          <section class="border-t border-hairline pt-18 pb-10">
            <h2 class="m-0 pb-8 font-serif text-heading font-normal">{anyMarks ? "Legends and marks" : "Legends"}</h2>
            {type.sides.map((s) => (
              <article class="grid gap-x-18 gap-y-8 border-t border-hairline py-12 md:grid-cols-[340px_minmax(0,1fr)]">
                <div class="flex flex-col gap-4">
                  {/* A small plinth that disappears if its photo fails: the label and description stand alone. */}
                  {sidePhoto(s.side) && (
                    <span data-plinth="hide" class="relative block size-20 bg-plinth">
                      <img src={sidePhoto(s.side)!} alt="" data-coin-photo class="absolute inset-0 size-full object-contain p-1.5 mix-blend-multiply" loading="lazy" />
                    </span>
                  )}
                  <div class="flex flex-col gap-1.5">
                    <h3 class="m-0 text-ui font-normal text-stone">{sideLabel[s.side]}</h3>
                    {s.description && <p class="m-0 max-w-[30ch] font-serif text-reading leading-[1.35] text-pretty">{s.description}</p>}
                  </div>
                </div>
                <div class="flex min-w-0 flex-col gap-9">
                  {s.segments && glossed(s) ? (
                    <div class="flex flex-col gap-5">
                      {/* Gandhari, Lycian and Carian segments are transliterated: show the original script above them. */}
                      {TRANSLITERATED.has(s.language ?? "") && s.legend && <LegendText legend={s.legend} language={s.language} />}
                      <LegendTable segments={s.segments} language={s.language} rulers={new Set(s.rulers)} />
                    </div>
                  ) : s.legend ? (
                    <LegendText legend={s.legend} language={s.language} transliteration={s.transliteration} />
                  ) : (
                    <p class="m-0 text-body text-stone md:pt-26">No legend.</p>
                  )}
                  {s.marks.length > 0 && (
                    <ul class="m-0 flex list-none flex-wrap gap-x-8 gap-y-6 p-0" aria-label={`${sideLabel[s.side]} monograms and marks`}>
                      {s.marks.map((m) => (
                        <li>
                          <figure class="m-0 flex items-center gap-4" title={m.definition ?? undefined}>
                            <span data-plinth={m.image ? "small" : undefined} class="flex size-14 flex-none items-center justify-center bg-plinth p-1.5">
                              {m.image ? (
                                <img src={m.image} alt={m.letters ? `Monogram of ${m.letters}` : m.name} data-coin-photo class="size-full object-contain mix-blend-multiply" loading="lazy" />
                              ) : (
                                <span class="text-center text-credit text-stone">No drawing</span>
                              )}
                            </span>
                            <figcaption class="flex flex-col gap-0.5 text-ui text-stone">
                              <span class="text-body text-ink">{m.name}</span>
                              {m.letters && (
                                <span>
                                  <span lang={/[\u0370-\u03FF]/.test(m.letters) ? "grc" : undefined} class="font-serif text-body tracking-[0.08em]">{m.letters}</span>
                                  {m.uncertain && " · uncertain"}
                                </span>
                              )}
                              {!m.letters && m.uncertain && <span>uncertain</span>}
                            </figcaption>
                          </figure>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </section>
        )}

        {/* Museum coins of this type: the one interactive island on the page */}
        <section class="flex flex-col gap-8 border-t border-hairline pt-18 pb-22">
          <SectionHeading>Specimens</SectionHeading>
          {type.specimens.length ? (
            <SpecimenTable
              client:visible
              specimens={type.specimens.map((s) => ({
                id: s.id,
                url: s.url,
                holder: s.holder,
                identifier: s.identifier,
                weight: s.weight,
                diameter: s.diameter,
                dieAxis: s.dieAxis,
                licence: s.credit.licence,
                thumbs: s.thumbs,
                photos: s.photos,
              }))}
            />
          ) : (
            <p class="m-0 text-body text-stone">No museum specimens are linked to this type yet.</p>
          )}
        </section>

        {type.variants.length > 0 && (
          <section class="flex flex-col gap-10 border-t border-hairline pt-18 pb-22">
            <SectionHeading aside={`${type.variants.length}`}>Variants</SectionHeading>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-x-6 gap-y-10">
              {type.variants.map((v) => (
                <TypeCard href={typePath(v.id)} image={v.image} plinthLegend={v.plinthLegend} title={v.title} reference={v.reference} meta={v.meta} />
              ))}
            </div>
            <PhotoCredit photos={type.variantCredits} />
          </section>
        )}

        {type.related.length > 0 && (
          <section class="flex flex-col gap-10 border-t border-hairline pt-18 pb-24">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="m-0 font-serif text-heading font-normal">Same issue</h2>
              {ruler &&
                (ruler === stated ? (
                  <a href={`/person/${ruler.id}?struck=name`} class={buttonVariants({ variant: "link" })}>All types in the name of {ruler.name}</a>
                ) : (
                  <a href={`/person/${ruler.id}`} class={buttonVariants({ variant: "link" })}>All types of {ruler.name}</a>
                ))}
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-x-6 gap-y-10">
              {type.related.map((r) => (
                <TypeCard href={typePath(r.id)} image={r.image} plinthLegend={r.plinthLegend} title={r.title} reference={r.reference} meta={r.meta} />
              ))}
            </div>
            <PhotoCredit photos={type.relatedCredits} />
          </section>
        )}
      </main>
    )
  }
  <SiteFooter />
</Base>

<script>
  // Runs on every page load, including client-router navigations (scripts only run once otherwise).
  document.addEventListener("astro:page-load", () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "")
        const label = button.textContent
        button.textContent = "Copied"
        setTimeout(() => (button.textContent = label), 1500)
      })
    }
  })
</script>
