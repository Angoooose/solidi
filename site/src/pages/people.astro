---
/*
 * People who issued coins, each on one time axis (lived, in office, coins dated): /people?collection=seleucid
 * ?collection= picks the collection (default: all),
 * ?sort= orders by date, types or name. The filter box narrows the list in the browser.
 */
import { env } from "cloudflare:workers"
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { Note, Page } from "@/components/collection"
import { PersonTrack, PersonTrackKey, YearAxis, niceStep, yearTicks } from "@/components/charts"
import { UrlSelect } from "@/components/url-select"
import { capitalise, yearRange } from "@/lib/format"
import { collectionOptions, fmt, getCategories, getPeople, peopleNoun, tree, type PeopleSort } from "@/lib/categories"

const SORTS: { value: PeopleSort; label: string }[] = [
  { value: "date", label: "By date" },
  { value: "types", label: "Most types first" },
  { value: "name", label: "By name" },
]
const sort = SORTS.find((s) => s.value === Astro.url.searchParams.get("sort"))?.value ?? "date"
const t = tree(await getCategories(env.DB))
const requested = Astro.url.searchParams.get("collection")
const category = requested ? (t.byId.get(requested) ?? null) : null
if (requested && !category) Astro.response.status = 404

const rows = requested && !category ? [] : await getPeople(env.DB, category?.id ?? null, sort)
const noun = peopleNoun(category?.id ?? null)

// The axis spans office and coins; lifetimes are clipped to it.
const starts = rows.flatMap((r) => [...(r.office ?? []), ...(r.coins ?? [])])
const from = starts.length ? Math.min(...starts) : -100
const to = starts.length ? Math.max(...starts) : 100
const step = niceStep([from, to], 6)
const domain: [number, number] = [Math.floor(from / step) * step - step / 2, Math.ceil(to / step) * step + step / 2]
const ticks = yearTicks(domain, step)
const pct = (y: number) => ((y - domain[0]) / (domain[1] - domain[0])) * 100

const options = collectionOptions(t, (c) => c.people)
const sortHref = (s: PeopleSort) => {
  const url = new URL(Astro.url)
  if (s === "date") url.searchParams.delete("sort")
  else url.searchParams.set("sort", s)
  return url.pathname + url.search
}
const COLS = "md:grid-cols-[minmax(0,300px)_150px_minmax(0,1fr)_64px]"
---

<Base title={category ? `${capitalise(noun.many)} · ${category.name}` : "People"} description="Kings, emperors, magistrates and moneyers who issued ancient coins, each with the coin types struck in their name.">
  <SiteHeader current="People" />
  <Page>
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 pt-8">
      <h1 class="m-0 font-serif text-display font-normal">{capitalise(noun.many)}</h1>
      <Note className="text-ui" data-count>
        {requested && !category ? `No collection called ${requested}` : `${fmt(rows.length)} on ${category ? `${category.name} coins` : "coins in every collection"}`}
      </Note>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
      <label class="flex h-12 min-w-[240px] flex-1 items-center gap-2.5 border border-field px-3.5 focus-within:border-ink">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="text-ink"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input type="search" data-filter placeholder={`Filter ${noun.many}`} aria-label={`Filter ${noun.many}`} class="min-w-0 flex-1 border-0 bg-transparent text-ui text-ink outline-0 placeholder:text-stone" />
      </label>
      <UrlSelect client:idle label="Collection" param="collection" value={category?.id ?? "all"} options={options} />
      <UrlSelect client:idle label="Sort" param="sort" value={sort} options={SORTS} />
    </div>

    {/* The key, over the bars' column. */}
    <div class:list={["mt-10 grid gap-6", COLS]}>
      <PersonTrackKey className="md:col-start-3" />
    </div>

    <div class:list={["mt-4 hidden items-end gap-6 border-b border-ink pb-2.5 md:grid", COLS]}>
      <a href={sortHref("name")} class:list={["text-ui underline-offset-4 hover:underline", sort === "name" ? "text-ink" : "text-stone"]}>Name</a>
      <a href={sortHref("date")} class:list={["text-ui underline-offset-4 hover:underline", sort === "date" ? "text-ink" : "text-stone"]}>In office</a>
      <YearAxis domain={domain} ticks={ticks} />
      <a href={sortHref("types")} class:list={["text-right text-ui underline-offset-4 hover:underline", sort === "types" ? "text-ink" : "text-stone"]}>Types</a>
    </div>

    <div class="relative mt-6 border-t border-ink md:mt-0 md:border-t-0" data-rows>
      {/* The axis's gridlines, drawn once behind every row's bar. */}
      <div aria-hidden="true" class:list={["pointer-events-none absolute inset-0 hidden gap-6 md:grid", COLS]}>
        <span></span><span></span>
        <span class="relative">
          {ticks.map((tk) => <span class="absolute inset-y-0 w-px bg-hairline" style={{ left: `${pct(tk)}%` }}></span>)}
        </span>
        <span></span>
      </div>
      {
        rows.map((r) => {
          const office = r.office && yearRange(...r.office)
          const coins = r.coins && yearRange(...r.coins)
          const lived = r.lived && yearRange(...r.lived)
          const tip = [r.name, lived && `Lived ${lived}`, office && `In office ${office}`, coins && `Coins dated ${coins}`, `${fmt(r.n)} ${r.n === 1 ? "type" : "types"}`]
            .filter(Boolean)
            .join("\n")
          const richTip = {
            title: r.name,
            rows: [
              ...(lived ? [["lived", "Lived", lived]] : []),
              ...(office ? [["office", "In office", office]] : []),
              ...(coins ? [["coins", "Coins dated", coins]] : []),
            ] as [string, string, string][],
            foot: `${fmt(r.n)} ${r.n === 1 ? "type" : "types"}`,
          }
          return (
            <a
              href={`/person/${r.id}`}
              data-name={r.name.toLowerCase()}
              class:list={[
                "group relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-1 border-b border-hairline py-2.5 transition-[background-color,box-shadow] hover:bg-wash hover:shadow-[-12px_0_0_var(--color-wash),12px_0_0_var(--color-wash)] md:py-[9px]",
                COLS,
              ]}
            >
              <span class="col-start-1 row-start-1 font-serif text-subtitle leading-[1.2] decoration-1 underline-offset-4 group-hover:underline md:col-start-auto md:row-start-auto">{r.name}</span>
              <span class:list={["num col-span-2 text-ui md:col-span-1", office ? "text-ink" : "text-stone"]} data-tip={!office && coins ? "No dates in office known: the dates of their coins" : undefined}>
                {office ?? coins ?? "—"}
              </span>
              <span class="col-span-2 md:col-span-1">
                <PersonTrack office={r.office} coins={r.coins} lived={r.lived} domain={domain} tip={tip} richTip={richTip} />
              </span>
              <span class="num col-start-2 row-start-1 text-right text-ui md:col-start-auto md:row-start-auto">{fmt(r.n)}</span>
            </a>
          )
        })
      }
    </div>
    <p class="mt-6 hidden text-ui text-stone" data-empty>No {noun.many} match.</p>
  </Page>
  <SiteFooter />
</Base>

<script>
  import "@/scripts/tooltip"

  // Narrow the list by name as you type. Runs on every client-router swap too.
  function setup() {
    const input = document.querySelector<HTMLInputElement>("[data-filter]")
    const rows = [...document.querySelectorAll<HTMLElement>("[data-rows] [data-name]")]
    const empty = document.querySelector<HTMLElement>("[data-empty]")
    if (!input || input.dataset.ready) return
    input.dataset.ready = "1"
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase()
      let shown = 0
      for (const row of rows) {
        const match = !q || row.dataset.name!.includes(q)
        row.hidden = !match
        if (match) shown++
      }
      empty?.classList.toggle("hidden", shown > 0)
    })
  }
  setup()
  document.addEventListener("astro:page-load", setup)
</script>
