---
/*
 * Metal page: /metal/gold. Its most struck denominations with their
 * median weight and diameter in this metal, a photo and its facts (what the catalogues record its
 * types as, where the alloys differ), when and where it was struck, who struck it and at which
 * mints, then its coinage with filters (lib/coinage.ts). ?list=people (or mints) shows a column in full.
 */
import { env } from "cloudflare:workers"
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { Crumbs, FacetColumn, RowsHead, Section } from "@/components/collection"
import { DataList, DataRow } from "@/components/data"
import { niceStep, yearTicks } from "@/components/charts"
import { Coin } from "@/components/denomination"
import { SubjectCollectionRow } from "@/components/subject"
import { TypeCard } from "@/components/coin"
import { PhotoCredit } from "@/components/credits"
import { CoinageFilters } from "@/components/coinage-filters"
import { buttonVariants } from "@/components/ui/button"
import { typePath, yearRange } from "@/lib/format"
import { fmt } from "@/lib/categories"
import { PAGE_SIZE, type Facet } from "@/lib/coinage"
import { METAL_BIN, getMetal, parseQuery } from "@/lib/metals"

/** Each column's shortlist before "All N". */
const COLUMN = 8
/** The widest bar in the denominations table, px. */
const BAR = 110

const id = Astro.params.id ?? ""
const params = Astro.url.searchParams
const query = parseQuery(params)
const m = await getMetal(env.DB, id, query)
if (!m) Astro.response.status = 404

/** This page's URL with some parameters changed; null removes one. */
const link = (changes: Record<string, string | number | null>, hash = "") => {
  const url = new URL(Astro.url)
  for (const [k, v] of Object.entries(changes)) {
    if (v == null) url.searchParams.delete(k)
    else url.searchParams.set(k, String(v))
  }
  return `${url.pathname}${url.search}${hash}`
}

// One axis for "Over time".
const starts = m ? m.collections.flatMap((c) => c.bins.map((b) => b.start)) : []
const lo = starts.length ? Math.min(...starts) : -100
const hi = starts.length ? Math.max(...starts) + METAL_BIN : 100
const step = niceStep([lo, hi], 6)
const pad = Math.max(10, (hi - lo) * 0.04)
const domain: [number, number] = [lo - pad, hi + pad]
const ticks = yearTicks(domain, step)

const most = m ? Math.max(1, ...m.denominations.map((d) => d.types)) : 1
const bar = (n: number) => Math.max(2, Math.round((n / most) * BAR))

// Columns: a shortlist, or one in full (?list=people).
const full = params.get("list")
const column = (key: string, f: { items: Facet[]; total: number }, noun: string) => ({
  items: (full === key ? f.items : f.items.slice(0, COLUMN)).map((x) => ({ id: x.value, name: x.label, n: x.count })),
  all:
    f.total > COLUMN
      ? full === key
        ? { label: `Show the top ${COLUMN}`, href: link({ list: null }, "#columns") }
        : { label: `All ${fmt(f.total)} ${noun}`, href: link({ list: key }, "#columns") }
      : undefined,
})

// A collection chosen elsewhere (a parent) that the facet doesn't list.
const collectionOptions = m ? [...m.collectionFacet] : []
if (m && query.collection && !collectionOptions.some((o) => o.value === query.collection)) {
  collectionOptions.unshift({ value: query.collection, label: query.collection, count: m.total })
}
const filters = m
  ? [
      { label: "Collection", param: "collection", value: query.collection, options: collectionOptions, available: m.available.collection },
      { label: "Denomination", param: "denomination", value: query.denomination, options: m.denominationFacet, available: m.available.denomination },
      { label: "Issued by", param: "issuer", value: query.issuer, options: m.issuerFacet, available: m.available.issuer },
      { label: "Mint", param: "mint", value: query.mint, options: m.mintFacet, available: m.available.mint },
      { label: "Recorded as", param: "material", value: query.material, options: m.materialFacet, available: m.available.material },
    ]
  : []
const halves = m && m.greek && m.roman ? ` · Greek ${fmt(m.greek)}, Roman ${fmt(m.roman)}` : ""
---

<Base title={m?.name ?? "Metal not found"}>
  <SiteHeader />
  {
    !m ? (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)] py-24">
        <h1 class="m-0 font-serif text-display font-normal">Metal not found</h1>
        <p class="mt-6 text-body text-stone">
          There is no metal <span class="text-ink">{id}</span>. <a href="/metals" class="text-ink underline-offset-4 hover:underline">All metals</a>
        </p>
      </main>
    ) : (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)] pb-24">
        {/* Name, its denominations, photo and facts */}
        <section class="flex flex-col gap-8 pt-10">
          <Crumbs items={[{ href: "/metals", label: "Metals" }]} />
          <div class="grid gap-x-20 gap-y-10 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-start">
            <div class="flex min-w-0 flex-col gap-10">
              <div class="flex flex-wrap items-baseline gap-x-7 gap-y-2">
                <h1 class="m-0 font-serif text-display font-normal">{m.name}</h1>
                {yearRange(m.start, m.end) && <span class="num text-subtitle text-graphite">{yearRange(m.start, m.end)}</span>}
              </div>
              {m.denominations.length > 0 && (
                <div class="flex flex-col">
                  <table class="w-full border-collapse">
                    <thead>
                      <tr class="border-b border-ink text-left text-ui text-stone">
                        <th class="pr-4 pb-2.5 font-normal">Denomination</th>
                        <th class="hidden pr-4 pb-2.5 font-normal sm:table-cell">Dates</th>
                        <th class="pr-4 pb-2.5 text-right font-normal">Weight</th>
                        <th class="hidden pr-4 pb-2.5 text-right font-normal md:table-cell">Diameter</th>
                        <th class="pb-2.5 font-normal sm:w-[180px]">Types</th>
                      </tr>
                    </thead>
                    <tbody>
                      {m.denominations.map((d) => (
                        <tr class="border-b border-hairline align-baseline text-ui transition-colors hover:bg-wash">
                          <td class="py-3.5 pr-4">
                            <a href={`/denomination/${d.id}`} class="font-serif text-subtitle underline-offset-4 hover:underline">{d.name}</a>
                          </td>
                          <td class="num hidden py-3.5 pr-4 sm:table-cell">{yearRange(d.start, d.end)}</td>
                          <td class="num py-3.5 pr-4 text-right whitespace-nowrap">{d.weight != null ? `${d.weight.toFixed(2)} g` : "—"}</td>
                          <td class="num hidden py-3.5 pr-4 text-right whitespace-nowrap md:table-cell">{d.diameter != null ? `${d.diameter} mm` : "—"}</td>
                          <td class="num py-3.5 whitespace-nowrap">
                            <span class="mr-3 hidden h-1.5 rounded-[1.5px] bg-ink align-middle sm:inline-block" style={`width: ${bar(d.types)}px`}></span>
                            {fmt(d.types)}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="m-0 mt-3 text-ui text-stone">Median of the coins weighed and measured.</p>
                  <a href={`/denominations?metal=${m.id}`} class={buttonVariants({ variant: "outline", className: "mt-5 self-start" })}>
                    All {m.name.toLowerCase()} denominations
                  </a>
                </div>
              )}
            </div>
            <div class="flex flex-col gap-6">
              {m.photo && (
                <div class="flex h-[240px] items-center justify-center bg-plinth [--coin-s:0.86] md:h-[280px] md:[--coin-s:1]">
                  <Coin photo={m.photo} px={220} alt={`A ${m.name.toLowerCase()} coin`} />
                </div>
              )}
              <DataList>
                <DataRow label="Types">{`${fmt(m.types)}${halves}`}</DataRow>
                {m.collections.length > 0 && (
                  <DataRow label="Struck in" href="#over-time">
                    {`${fmt(m.collections.length)} ${m.collections.length === 1 ? "collection" : "collections"}`}
                  </DataRow>
                )}
                {m.people.total > 0 && (
                  <DataRow label="Struck for" href="#columns">
                    {`${fmt(m.people.total)} ${m.people.total === 1 ? "person" : "people"}`}
                  </DataRow>
                )}
                {m.recorded.length > 0 && (
                  <DataRow label="Recorded as">
                    {m.recorded.map((r, i) => (
                      <>
                        {i > 0 && <span class="text-stone"> · </span>}
                        <a href={link({ material: r.id, limit: null }, "#coinage")} class="underline-offset-4 hover:underline">{r.name}</a>
                        <span class="num text-stone"> {fmt(r.n)}</span>
                      </>
                    ))}
                  </DataRow>
                )}
                {m.specimens > 0 && (
                  <DataRow label="Specimens">
                    {`${fmt(m.specimens)}${m.holders ? ` in ${fmt(m.holders)} ${m.holders === 1 ? "museum or collection" : "museums and collections"}` : ""}`}
                  </DataRow>
                )}
              </DataList>
            </div>
          </div>
        </section>

        {/* Over time, one row per collection */}
        {m.collections.length > 0 && (
          <Section id="over-time" className="scroll-mt-6">
            <h2 class="m-0 mb-6 font-serif text-heading font-normal">Over time</h2>
            <div style="--aside: 150px">
              <RowsHead first="Collection" aside="Dates" domain={domain} ticks={ticks} className="border-b border-ink pb-3.5" />
              {m.collections.map((c) => (
                <SubjectCollectionRow
                  href={link({ collection: c.category.id, limit: null }, "#coinage")}
                  name={c.category.name}
                  dates={yearRange(c.start, c.end)}
                  bins={c.bins}
                  domain={domain}
                  ticks={ticks}
                  count={c.n}
                />
              ))}
            </div>
          </Section>
        )}

        {/* Who struck it, and where */}
        <Section id="columns" className="grid scroll-mt-6 items-start gap-x-14 gap-y-10 sm:grid-cols-2">
          <FacetColumn title="Struck for" {...column("people", m.people, "people")} href={(p) => `/person/${p}`} />
          <FacetColumn title="Mints" {...column("mints", m.mints, "mints")} href={(x) => `/mint/${x}`} />
        </Section>

        {/* Coinage */}
        <Section id="coinage" className="flex scroll-mt-6 flex-col gap-8">
          <h2 class="m-0 font-serif text-heading font-normal">Coinage</h2>
          <div class="border-b border-hairline pb-3">
            <CoinageFilters client:idle filters={filters} sort={query.sort} />
          </div>
          {m.grid.length ? (
            <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-x-6 gap-y-10">
              {m.grid.map((t) => (
                <TypeCard href={typePath(t.id)} image={t.image} plinthLegend={t.plinthLegend} title={t.title} reference={t.reference} meta={t.meta} />
              ))}
            </div>
          ) : (
            <p class="m-0 text-body text-stone">No types match these filters.</p>
          )}
          <PhotoCredit photos={m.typeCredits} />
          {m.total > m.grid.length && (
            <a data-keep-scroll href={link({ limit: query.limit + PAGE_SIZE })} class={buttonVariants({ variant: "outline", className: "self-center" })}>
              Show more types
              <span class="num font-normal text-stone">
                {fmt(m.grid.length)} of {fmt(m.total)}
              </span>
            </a>
          )}
        </Section>
      </main>
    )
  }
  <SiteFooter />
</Base>

<script>
  import "@/scripts/tooltip"
</script>
