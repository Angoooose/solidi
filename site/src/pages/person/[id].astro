---
/*
 * Person page: /person/trajan. Server-rendered from D1; "Show more" is a plain link and the filter
 * selects (an island) navigate to a new URL.
 */
import { env } from "cloudflare:workers"
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { SiteFooter } from "@/components/site-chrome"
import { DataList, DataRow, RowLink } from "@/components/data"
import { TypeCard } from "@/components/coin"
import { PhotoCredit } from "@/components/credits"
import { CoinageFilters } from "@/components/coinage-filters"
import { buttonVariants } from "@/components/ui/button"
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb"
import { IN_NAME, OWN, PAGE_SIZE, getPerson, parseQuery } from "@/lib/person"
import { capitalise, typePath } from "@/lib/format"
import { peopleNoun } from "@/lib/categories"

const id = Astro.params.id ?? ""
const query = parseQuery(Astro.url.searchParams)
const person = await getPerson(env.DB, id, query)
if (!person) Astro.response.status = 404
// "Emperors" under Roman Imperial, to that collection's people list; "People" when uncategorised.
const home = person?.categoryPath.at(-1)
const peopleCrumb = home
  ? { label: capitalise(peopleNoun(home.id).many), href: `/people?collection=${home.id}` }
  : { label: "People", href: "/people" }

/* A URL for this page with some parameters changed; null removes one. Used with data-keep-scroll. */
const link = (changes: Record<string, string | number | null>) => {
  const url = new URL(Astro.url)
  for (const [k, v] of Object.entries(changes)) {
    if (v == null) url.searchParams.delete(k)
    else url.searchParams.set(k, String(v))
  }
  return `${url.pathname}${url.search}`
}

const filters = person
  ? [
      { label: "Struck", param: "struck", value: query.struck, options: person.struckFacet, available: person.available.struck },
      { label: "Portrait", param: "portrait", value: query.portrait, options: person.portraitFacet, available: person.available.portrait },
      { label: "Issued by", param: "issuer", value: query.issuer, options: person.issuerFacet, available: person.available.issuer },
      { label: "Denomination", param: "denomination", value: query.denomination, options: person.denominationFacet, available: person.available.denomination },
      { label: "Date", param: "date", value: query.period, options: person.periodFacet, available: person.available.period },
    ]
  : []
---

<Base title={person?.name ?? "Person not found"}>
  <SiteHeader current="People" />
  {
    !person ? (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)] py-24">
        <h1 class="m-0 font-serif text-display font-normal">Person not found</h1>
        <p class="mt-6 text-body text-stone">
          There is no person <span class="text-ink">{id}</span>.
        </p>
      </main>
    ) : (
      <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)]">
        {/* Name, lead, facts */}
        <section class="flex flex-col gap-8 pt-10">
          <Breadcrumb>
            <BreadcrumbList>
              {person.categoryPath.map((c) => (
                <>
                  <BreadcrumbItem>
                    <BreadcrumbLink href={`/category/${c.id}`}>{c.name}</BreadcrumbLink>
                  </BreadcrumbItem>
                  <BreadcrumbSeparator />
                </>
              ))}
              <BreadcrumbItem>
                <BreadcrumbLink href={peopleCrumb.href}>{peopleCrumb.label}</BreadcrumbLink>
              </BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                <BreadcrumbPage>{person.name}</BreadcrumbPage>
              </BreadcrumbItem>
            </BreadcrumbList>
          </Breadcrumb>

          <div class="flex flex-wrap items-end justify-between gap-x-20 gap-y-6">
            <div class="flex min-w-0 flex-[1_1_560px] flex-col gap-4">
              <div class="flex flex-wrap items-baseline gap-x-7 gap-y-2">
                <h1 class="m-0 font-serif text-display font-normal">{person.name}</h1>
                {(person.ruled ?? person.lived) && <span class="text-subtitle text-graphite">{capitalise((person.ruled ?? person.lived)!)}</span>}
              </div>
              {person.lead && (
                <p class="m-0 max-w-[56ch] font-serif text-reading text-pretty">
                  {person.lead}
                  {person.article && (
                    <>
                      {" "}
                      <a
                        href={person.article.url}
                        rel="noopener"
                        class="font-sans text-ui font-medium whitespace-nowrap underline-offset-4 hover:underline"
                      >
                        Read more on Wikipedia ↗
                      </a>
                    </>
                  )}
                </p>
              )}
              {person.article && (
                <span class="text-credit text-stone">Text from Wikipedia, {person.article.licence}</span>
              )}
            </div>

            <DataList className="min-w-[300px] flex-[0_1_440px]">
              {person.ruled && <DataRow label="Ruled">{person.ruled}</DataRow>}
              {person.lived && <DataRow label="Lived">{person.lived}</DataRow>}
              {person.mainMint && (
                <DataRow label="Main mint" href={`/mint/${person.mainMint.id}`}>
                  {person.mainMint.name}
                </DataRow>
              )}
              {person.family.map((g) => (
                <DataRow label={g.relation}>
                  {g.people.map((p, i) => (
                    <>
                      {i > 0 && ", "}
                      <RowLink href={`/person/${p.id}`}>{p.name}</RowLink>
                    </>
                  ))}
                </DataRow>
              ))}
            </DataList>
          </div>
        </section>

        {/* Their portrait across the reign, as a timeline: a rule with a dot per portrait */}
        {person.portraits.length >= 2 && (
          <section class="flex flex-col gap-8 border-t border-hairline pt-18 mt-16">
            <h2 class="m-0 font-serif text-heading font-normal">
              {person.name}'s portrait{person.portraitSpan && `, ${person.portraitSpan.replace(/^AD /, "")}`}
            </h2>
            <div class="scroll-fade-x scrollbar-thin overflow-x-auto pb-2">
              <ol class="relative m-0 grid min-w-[880px] list-none grid-cols-6 gap-x-6 p-0">
                <span aria-hidden="true" class="absolute inset-x-0 top-[4px] h-px bg-hairline" />
                {person.portraits.map((p) => (
                  <li class="relative">
                    <a href={typePath(p.typeId)} class="group flex flex-col">
                      <span aria-hidden="true" class="block size-[9px] rounded-full bg-ink" />
                      <span class="mt-6 font-serif text-[26px] leading-tight">{p.years}</span>
                      <span class="num mt-1 text-label text-stone">
                        {p.denomination && `${p.denomination} · `}
                        <span class="underline-offset-4 group-hover:text-ink group-hover:underline">{p.reference}</span>
                      </span>
                      <span class="relative mt-5 block aspect-square bg-plinth">
                        <img
                          src={p.src}
                          alt={`${person.name}, ${p.years ?? ""}`}
                          loading="lazy"
                          class="absolute inset-0 size-full object-contain p-5 mix-blend-multiply"
                        />
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
            <PhotoCredit photos={person.portraitCredits} />
          </section>
        )}

        {/* Coinage */}
        <section id="coinage" class="flex scroll-mt-6 flex-col gap-8 pt-18 pb-24">
          <div class="flex flex-col gap-3">
            <h2 class="m-0 font-serif text-heading font-normal">Coinage</h2>
            {person.inNameCount > 0 && (
              <p class="m-0 max-w-[64ch] text-body text-graphite">
                {person.inNameCount.toLocaleString("en")} {person.inNameCount === 1 ? "type names" : "types name"} {person.name} on the coin
                but {person.inNameCount === 1 ? "was" : "were"} struck by others: later rulers, cities, magistrates, or issuers the
                catalogue does not record.{" "}
                <a
                  data-keep-scroll
                  href={link(query.struck === IN_NAME ? { struck: OWN, limit: null } : { struck: IN_NAME, limit: null })}
                  class="whitespace-nowrap underline decoration-field underline-offset-4 hover:text-stone"
                >
                  {query.struck === IN_NAME ? "Show own issues" : "Show only these"}
                </a>
              </p>
            )}
          </div>

          <div class="border-b border-hairline pb-3">
            <CoinageFilters client:idle filters={filters} sort={query.sort} />
          </div>

          {person.types.length ? (
            <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-x-6 gap-y-10">
              {person.types.map((t) => (
                <TypeCard href={typePath(t.id)} image={t.image} title={t.title} reference={t.reference} meta={t.meta} />
              ))}
            </div>
          ) : (
            <p class="m-0 text-body text-stone">No types match these filters.</p>
          )}

          <PhotoCredit photos={person.typeCredits} />

          {person.total > person.types.length && (
            <a data-keep-scroll href={link({ limit: query.limit + PAGE_SIZE })} class={buttonVariants({ variant: "outline", className: "self-center" })}>
                Show more types
                <span class="num font-normal text-stone">
                  {person.types.length} of {person.total.toLocaleString("en")}
                </span>
              </a>
          )}
        </section>
      </main>
    )
  }
  <SiteFooter />
</Base>
