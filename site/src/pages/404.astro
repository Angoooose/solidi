---
/*
 * Page not found: which path has no page, and the search box to find what was meant.
 */
import Base from "@/layouts/Base.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import SearchBox from "@/components/SearchBox.astro"

Astro.response.status = 404
const path = (() => {
  try {
    return decodeURI(Astro.url.pathname)
  } catch {
    return Astro.url.pathname // a malformed escape: show it as typed
  }
})()
---

<Base title="Page not found · Solidi">
  <SiteHeader />
  <main class="mx-auto max-w-page px-[clamp(20px,4vw,56px)]">
    <section class="flex max-w-[760px] flex-col gap-7 pt-24 pb-32 md:pt-40 md:pb-50">
      <h1 class="m-0 font-serif text-[clamp(3rem,6vw,4.5rem)] leading-none font-normal tracking-[-0.02em] text-balance">Page not found</h1>
      <p class="m-0 text-[1.125rem] leading-[1.55] break-words text-graphite">
        There’s no page at <code class="bg-plinth px-1.5 py-0.5 font-mono text-body text-ink">{path}</code>.
      </p>
      <SearchBox size="md" class="mt-3" />
    </section>
  </main>
  <SiteFooter />
</Base>
